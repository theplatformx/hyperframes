{
  "name": "studiox-motion-film",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "lint": "hyperframes lint",
    "check": "node scripts/verify-manifest.mjs && hyperframes check --samples 21",
    "preview": "hyperframes preview",
    "render": "hyperframes render --fps 30 --quality looks --output renders/StudioX-1080p.mp4",
    "render:4k": "hyperframes render --fps 30 --quality delivery --resolution landscape-4k --output renders/StudioX-4K.mp4"
  },
  "dependencies": {
    "gsap": "3.14.2",
    "hyperframes": "0.8.145"
  },
  "engines": {
    "node": ">=22"
  }
}
